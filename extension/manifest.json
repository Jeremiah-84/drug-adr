{
  "manifest_version": 3,
  "name": "약 이상반응 찾기",
  "version": "1.0.0",
  "description": "처방 약 중 새로 생긴 문제(신기능·간수치·증상)를 일으킬 수 있는 약을 식약처 첨부문서 기준으로 찾아봅니다.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "약 이상반응 찾기 열기",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "옆 패널 열기"
    }
  },
  "homepage_url": "https://jeremiah-84.github.io/drug-adr/install.html"
}